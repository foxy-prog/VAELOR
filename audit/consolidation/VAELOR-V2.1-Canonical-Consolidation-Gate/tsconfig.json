{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": [
  "node-shim.d.ts",
  "pg-shim.d.ts",
  "packages/**/*.ts",
  "services/**/*.ts",
  "tests/**/*.ts",
  "scripts/**/*.ts"
]
}
