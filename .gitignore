# ============================================================
# VÆLOR — Git Ignore
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example
!.env.template

# Secret/config material
secrets/
credentials/
*.secret
*.secrets
*.token

# ---------- Cryptographic Material ----------
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore

# ---------- Databases / Runtime State ----------
*.db
*.sqlite
*.sqlite3
data/
runtime-data/
state/
backups/

# ---------- Logs ----------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Build / Generated Output ----------
dist/
build/
out/
coverage/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/

# ---------- Temporary Files ----------
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo

# ---------- Archives / Local Packages ----------
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# ---------- Docker Local Overrides ----------
docker-compose.override.yml
.docker/

# ---------- OS ----------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ---------- IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml

# ---------- TypeScript ----------
*.tsbuildinfo

# ---------- Test Artifacts ----------
test-results/
playwright-report/
blob-report/

# ---------- Local Development ----------
.local/
.localhost/
dev-data/

# ---------- Generated Documentation ----------
docs/generated/

# ---------- VÆLOR Local Artifacts ----------
.vaelor-local/
.vaelor-runtime/
.vaelor-cache/
.vaelor-state/

# ---------- Never Commit These ----------
# Real VÆLANCE identity material
vaelance-private/
vaelance-keys/
device-keys/

# Production deployment material
production-secrets/
production-credentials/
